# Mathemzi Edu — Environment Variables
# Copy this file to .env.local and adjust values

# === Demo Mode ===
# Demo mode is for local/client preview only. Keep disabled in production.
# When enabled, shows "Demo Student" and "Demo Admin" buttons on the Login page.
# Demo sessions use localStorage — no real Firebase authentication needed.
# WARNING: Never set VITE_DEMO_MODE=true in production builds.
VITE_DEMO_MODE=false
